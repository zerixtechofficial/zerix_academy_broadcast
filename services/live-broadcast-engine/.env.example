# Service Network Binding
PORT=4000
HOST=0.0.0.0

# Data Source Mode: "mock_json" (for standalone offline testing) or "laravel_api"
DATA_SOURCE_MODE=mock_json

# Redis 7.4 Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# LiveKit Two-Way SFU Audio Configuration
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Public URL used by frontend browser clients to connect to LiveKit SFU (change to LAN IP for mobile testing, e.g. ws://192.168.31.19:7880)
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880

# Fail-Safe Auto-Save & Grace Timers
# Default 300s (5 minutes) for production. Set to 30s for rapid local testing
TEACHER_GRACE_TIMEOUT_SECONDS=300
CHECKPOINT_INTERVAL_SECONDS=30

# Laravel API Integration (Active when DATA_SOURCE_MODE=laravel_api)
LARAVEL_API_BASE_URL=http://127.0.0.1:8000
LARAVEL_INTERNAL_API_SECRET=zerix_internal_broadcast_secret_2026
BROADCAST_JWT_SECRET=zerix_broadcast_shared_jwt_secret_2026

# Cloud-Agnostic Storage Adapter (Cloudflare R2 <-> AWS S3 <-> Local Disk)
# STORAGE_DRIVER: "local_disk" (default for local Ubuntu testing via storage_cache/) or "s3_compatible"
# - For Cloudflare R2: set STORAGE_DRIVER=s3_compatible, STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com, STORAGE_REGION=auto
# - For AWS S3: set STORAGE_DRIVER=s3_compatible, leave STORAGE_ENDPOINT= empty, and set STORAGE_REGION=ap-south-1
STORAGE_DRIVER=local_disk
STORAGE_ENDPOINT=
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=broadcast-sessions
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_CDN_URL=

# Legacy R2 Variables (kept for backward compatibility)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=broadcast-sessions
R2_ENDPOINT=

# Telegram Error Alerting & Daily 11:00 PM Health Report Configuration
TELEGRAM_BOT_TOKEN=8624790281:AAHsADm9eq_-DU4vJ9Y5v7b9lP-q34jqYn0
TELEGRAM_ERROR_CHAT_ID="-5264089817"
TELEGRAM_DAILY_REPORT_TIME=23:00
FRONTEND_HEALTH_URL=http://127.0.0.1:3000

